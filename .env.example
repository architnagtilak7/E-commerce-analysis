# ========================================================
# MongoDB Atlas & Environment Configuration
# ========================================================

# 1. MongoDB Atlas Connection URI:
# Replace <username>, <password>, and <cluster-name> with your MongoDB Atlas credentials:
# Example: mongodb+srv://archit_admin:MySecurePass123@cluster0.abcde.mongodb.net/dcds_ecommerce_sdg?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/dcds_ecommerce_sdg?retryWrites=true&w=majority

# 2. Database Name:
MONGODB_DB_NAME=dcds_ecommerce_sdg

# 3. Server Configuration (Render injects PORT automatically):
PORT=8000
ENVIRONMENT=production
